# Platform-specific Extension IDs for production builds
# 生产构建的扩展 ID 配置

# Chromium 扩展公钥 (从 Chrome 扩展管理页面获取)
MX_CHROMIUM_ID=your_chromium_public_key

# Chromium 自动更新 URL (可选，用于自托管更新)
MX_CHROMIUM_UPDATE_URL=https://your-domain.com/maoxian-web-clipper/chrome-updates.xml

# Firefox 扩展 ID (从 AMO 获取或自定义)
MX_FIREFOX_ID=maoxian-web-clipper@your-domain.org

# 环境配置
NODE_ENV=production
